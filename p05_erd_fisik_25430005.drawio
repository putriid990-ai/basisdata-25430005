2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#4a5a6b;" edge="1" parent="1" source="t_peminjaman" target="t_detail_peminjaman"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="dikenai" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#1B3A5C;startArrow=ERmandOne;startFill=0;endArrow=ERzeroToMany;endFill=0;startSize=14;endSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#4a5a6b;" edge="1" parent="1" source="t_peminjaman_r0" target="t_denda_r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="tercatat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#1B3A5C;startArrow=ERzeroToMany;startFill=0;endArrow=ERmandOne;endFill=0;startSize=14;endSize=14;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#4a5a6b;" edge="1" parent="1" source="t_detail_peminjaman_r1" target="t_eksemplar_r0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="memiliki" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#1B3A5C;startArrow=ERmandOne;startFill=0;endArrow=ERoneToMany;endFill=0;startSize=14;endSize=14;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;fontStyle=2;fontColor=#4a5a6b;" edge="1" parent="1" source="t_buku" target="t_eksemplar"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="legend" value="&lt;b&gt;Keterangan&lt;/b&gt;&lt;br&gt;PK = kunci primer; PK,FK = kunci primer komposit sekaligus kunci tamu&lt;br&gt;FK = kunci tamu; &amp;#8594; tabel tujuan; semua memakai ON DELETE RESTRICT (NFR-01)&lt;br&gt;&lt;font color=&quot;#E65100&quot;&gt;&amp;#9670;&lt;/font&gt; = nilai turunan yang sengaja disimpan (keputusan Modul 4), dijaga CHECK/transaksi&lt;br&gt;&lt;font color=&quot;#1565C0&quot;&gt;&lt;b&gt;PRIBADI&lt;/b&gt;&lt;/font&gt; = data pribadi anggota (NFR-02)&lt;br&gt;Nilai ENUM ditulis di kolom tipe; tipe dan constraint sama persis dengan DDL&lt;br&gt;&lt;br&gt;&lt;b&gt;Aturan yang tidak dapat dijaga CHECK (untuk Modul 14):&lt;/b&gt;&lt;br&gt;AB-02 status anggota aktif saat meminjam; AB-04 dan AB-09 satu peminjaman aktif per eksemplar;&lt;br&gt;AB-05 maksimal 8 eksemplar per peminjaman; AB-06 sinkron status eksemplar; AB-08 denda otomatis." style="rounded=1;arcSize=3;fillColor=#F7FAFD;strokeColor=#9DB4CC;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;fontSize=12;fontColor=#12263f;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="720" width="770" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>